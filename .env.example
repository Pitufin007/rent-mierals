# ─── Servidor ───────────────────────────────────────────────
PORT=3000
# En producción (Render) DEBE ser "production": activa cookies "secure",
# HSTS y oculta los mensajes de error internos.
NODE_ENV=development

# ─── Seguridad ──────────────────────────────────────────────
# Secreto para firmar las cookies de sesión. OBLIGATORIO en producción
# (el servidor no arranca si falta o es muy corto). Usa un valor largo y
# aleatorio, por ejemplo generado con:  openssl rand -base64 32
SESSION_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Orígenes permitidos para CORS (separados por coma). Normalmente NO hace
# falta porque el frontend se sirve desde el mismo origen que la API.
# Solo úsalo si vas a consumir la API desde otro dominio.
# CORS_ORIGINS=https://mi-otro-dominio.com

# ─── Base de datos (Azure SQL) ──────────────────────────────
DB_SERVER=tu-servidor.database.windows.net
DB_PORT=1433
DB_DATABASE=tu_base_de_datos
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_ENCRYPT=true

# ─── Google OAuth ───────────────────────────────────────────
GOOGLE_CLIENT_ID=tu_client_id
GOOGLE_CLIENT_SECRET=tu_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
